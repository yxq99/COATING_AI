# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/

# Packaging and local environments
*.egg-info/
build/
dist/
.venv/
venv/
env/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
._*
~$*

# Local secrets and logs
.env
.env.*
*.log
*.pem
*.key

# Personal debugging scratchpad
src/Test.py

# Generated models and predictions
output/
outputs/
/local/

# Guard against accidentally committing custom exports outside data/ and output/.
*.[cC][sS][vV]
*.[tT][sS][vV]
*.[xX][lL][sS]
*.[xX][lL][sS][xXmMbB]
*.[pP][aA][rR]
*.[dD][aA][tT]
*.parquet
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.pkl
*.joblib

# Measurements, source instruments and filled workbooks stay local.
# Only effective configuration is tracked under data/.
data/*
!data/project.yaml
!data/early_model.yaml

# Local reference copies; the maintained guide is COATING_ML_GUIDE.md.
/document/CODE_EXPLAINED.md
/document/COATING_ML_PAPER_PLAN.md
/document/ML_THEORY.md

# Notebook checkpoints
.ipynb_checkpoints/
